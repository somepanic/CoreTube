<?xml version="1.0" encoding="UTF-8"?>
<addon id="repository.coretube" name="CoreTube Repository" version="1.0.2" provider-name="CoreTube">
  <extension point="xbmc.addon.repository">
    <!-- the somepanic Kodi repository's lists: Kodi 21 (CoreELEC 21, ARM) -->
    <dir minversion="21.0.0" maxversion="21.89.999">
      <info>https://somepanic.github.io/omega/addons.xml</info>
      <checksum verify="sha256">https://somepanic.github.io/omega/addons.xml.sha256</checksum>
      <datadir>https://somepanic.github.io/omega/</datadir>
      <hashes>sha256</hashes>
    </dir>
    <!-- Kodi 22 and its 21.90+ pre-releases (CoreELEC 22, AArch64) -->
    <dir minversion="21.90.0" maxversion="22.89.999">
      <info>https://somepanic.github.io/piers/addons.xml</info>
      <checksum verify="sha256">https://somepanic.github.io/piers/addons.xml.sha256</checksum>
      <datadir>https://somepanic.github.io/piers/</datadir>
      <hashes>sha256</hashes>
    </dir>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary>CoreTube updates for CoreELEC</summary>
    <description>Install CoreTube on CoreELEC 21 (ARM) or CoreELEC 22 (AArch64). Kodi selects the matching package.</description>
    <license>BSD-3-Clause</license>
    <platform>all</platform>
    <assets>
      <icon>resources/icon.png</icon>
    </assets>
  </extension>
</addon>
